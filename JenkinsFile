pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                echo 'Fetching source code from GitHub...'
                checkout scm
            }
        }

        stage('Build App & Unit Tests') {
            steps {
                echo 'Compiling main.exe and test.exe...'
                bat 'g++ -o main.exe main.cpp'
                bat 'g++ -o test.exe test.cpp'
            }
        }

        stage('Run Unit Tests') {
            steps {
                echo 'Executing automated C++ unit tests...'
                // 直接執行編譯好的 test.exe，若 assert 失敗會自動中斷 Pipeline
                bat 'test.exe'
            }
        }

        stage('Archive Release Artifact') {
            steps {
                echo 'Archiving main.exe release artifact...'
                // 僅發行正式主程式 main.exe，不包含 test.exe
                archiveArtifacts artifacts: 'main.exe', fingerprint: true
            }
        }
    }

    post {
        success {
            echo '✅ Build, unit tests, and artifact archiving ALL PASSED!'
        }
        failure {
            echo '❌ Pipeline FAILED! Check Console Output for compilation or unit test assertion errors.'
        }
    }
}