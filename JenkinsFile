pipeline {
    agent any
    stages {
        stage('Build') {
            steps {
                echo '模擬編譯軟體...'
                // 在 Windows 上產出一個模擬的執行檔或打包檔
                bat 'echo "V1.0 Release Build" > my_app.exe'
            }
        }
        stage('Archive') {
            steps {
                // 告訴 Jenkins 把產出的 my_app.exe 保存並顯示在建置頁面上
                archiveArtifacts artifacts: 'my_app.exe', fingerprint: true
            }
        }
    }
}