pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                echo '從 GitHub 拉取 C++ 最新原始碼...'
                checkout scm
            }
        }

        stage('Build C++ App') {
            steps {
                echo '編譯 C++ 程式碼為 main.exe...'
                // 使用 g++ 將 main.cpp 編譯成 main.exe
                bat 'g++ -o main.exe main.cpp'
            }
        }

        stage('Automated Test') {
            steps {
                echo '執行自動化測試 (自動帶入測試值 10 與 20)...'
                // 將 "10 20" 輸入給 main.exe 進行非互動式自動測試
                bat 'echo 10 20 | main.exe'
            }
        }

        stage('Archive Release Artifact') {
            steps {
                echo '發行成果：將 main.exe 歸檔儲存至 Jenkins 建置頁面...'
                archiveArtifacts artifacts: 'main.exe', fingerprint: true
            }
        }
    }

    post {
        success {
            echo '✅ C++ 專案編譯、自動化測試與產物歸檔完全成功！'
        }
        failure {
            echo '❌ 執行失敗！請確認系統環境變數 PATH 中是否包含 g++ 編譯器。'
        }
    }
}