pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                echo 'Fetching source code from GitHub...'
                checkout scm
            }
        }

        stage('Build C++ App') {
            steps {
                echo 'Compiling main.cpp into main.exe...'
                bat 'g++ -o main.exe main.cpp'
            }
        }

        stage('Automated Test & Verification') {
            steps {
                echo 'Running test and verifying calculation (10 + 20 = 30)...'
                // 自動帶入 10 20，並比對輸出文字是否精準包含 "10 + 20 = 30"
                // 若找不到 "10 + 20 = 30"，findstr 會丟出 exit code 1，引發 Jenkins 建置失敗
                bat 'echo 10 20 | main.exe | findstr /C:"10 + 20 = 30"'
            }
        }

        stage('Archive Release Artifact') {
            steps {
                echo 'Archiving main.exe artifact...'
                archiveArtifacts artifacts: 'main.exe', fingerprint: true
            }
        }
    }

    post {
        success {
            echo '✅ Build, calculation verification, and artifact archiving ALL PASSED!'
        }
        failure {
            echo '❌ Verification FAILED! Calculation output does not match expected result.'
        }
    }
}